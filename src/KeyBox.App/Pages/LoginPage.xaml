<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KeyBox.App.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel
            Width="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="14">
            <TextBlock
                Text="KeyBox"
                FontSize="30"
                FontWeight="Bold"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="端到端加密密钥保管箱"
                FontSize="13"
                Foreground="Gray"
                HorizontalAlignment="Center"
                Margin="0,0,0,12" />

            <TextBox
                Header="手机号"
                PlaceholderText="请输入手机号"
                Text="{x:Bind ViewModel.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    Header="验证码"
                    PlaceholderText="6 位验证码"
                    Text="{x:Bind ViewModel.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.SendCodeCommand}"
                    Content="{x:Bind ViewModel.SendCodeButtonText}" />
            </Grid>

            <Button
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.LoginCommand}"
                Content="登录" />

            <ProgressRing
                Width="28"
                Height="28"
                HorizontalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsBusy}"
                Visibility="{x:Bind ViewModel.ProgressVisibility, Mode=OneWay}" />

            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="Gray"
                TextWrapping="Wrap"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
