<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KeyBox.App.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource KbBgBrush}">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                MaxWidth="420"
                Spacing="12"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <TextBlock
                    Text="注册 KeyBox"
                    FontSize="26"
                    FontWeight="Bold"
                    HorizontalAlignment="Center" />

                <!-- 步骤 1：手机号验证码登录（平台层，未注册号码也可登录） -->
                <StackPanel x:Name="StepOnePanel" Spacing="12">
                    <TextBlock
                        Text="第 1 步：手机号验证码登录"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource KbMutedBrush}" />
                    <TextBox
                        Header="手机号"
                        PlaceholderText="请输入手机号"
                        Text="{x:Bind Login.Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            Grid.Column="0"
                            Header="验证码"
                            PlaceholderText="6 位验证码"
                            Text="{x:Bind Login.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Bottom"
                            Command="{x:Bind Login.SendCodeCommand}"
                            Content="{x:Bind Login.SendCodeButtonText, Mode=OneWay}" />
                    </Grid>
                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind Login.LoginCommand}"
                        Content="验证并继续" />
                </StackPanel>

                <!-- 步骤 2：邀请码 + 主密码（登录成功后出现） -->
                <StackPanel x:Name="StepTwoPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock
                        x:Name="StepTwoHint"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource KbMutedBrush}" />
                    <TextBox
                        x:Name="InviteBox"
                        Header="一次性邀请码"
                        PlaceholderText="向管理员索取" />
                    <PasswordBox
                        x:Name="PwdBox"
                        Header="主密码（至少 8 位，忘记无法找回）"
                        PasswordChanged="OnPasswordChanged" />
                    <PasswordBox
                        x:Name="ConfirmBox"
                        Header="确认主密码"
                        PasswordChanged="OnConfirmChanged" />
                    <Button
                        x:Name="SubmitButton"
                        Content="完成注册"
                        HorizontalAlignment="Stretch"
                        Style="{ThemeResource AccentButtonStyle}"
                        IsEnabled="False"
                        Click="OnSubmitClick" />
                </StackPanel>

                <TextBlock
                    x:Name="StatusText"
                    Text=""
                    TextWrapping="Wrap"
                    FontSize="12"
                    Foreground="{ThemeResource KbDangerBrush}" />

                <ProgressRing
                    x:Name="BusyRing"
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />

                <Button
                    Content="返回登录页"
                    HorizontalAlignment="Stretch"
                    Click="OnBackClick" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>