<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KeyBox.App.Controls.SecurityPanelControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Width="460" Padding="2,2,6,4">

            <ProgressRing
                Width="28"
                Height="28"
                HorizontalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading}"
                Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}" />
            <ProgressRing
                Width="24"
                Height="24"
                HorizontalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsBusy}"
                Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />

            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{x:Bind ViewModel.StatusBrush, Mode=OneWay}"
                TextWrapping="Wrap"
                FontSize="12" />

            <!-- ── R28 恢复码 ── -->
            <StackPanel Spacing="8">
                <TextBlock Text="恢复码（R28）" FontWeight="SemiBold" FontSize="14" />
                <TextBlock
                    Text="{x:Bind ViewModel.RecoveryStatusText, Mode=OneWay}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Foreground="Gray" />
                <Button
                    Content="我已抄下并自行保管"
                    Click="OnAckRecoveryClick"
                    IsEnabled="{x:Bind ViewModel.IdleEnabled, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.AckButtonVisibility, Mode=OneWay}"
                    HorizontalAlignment="Stretch" />
            </StackPanel>

            <Border Height="1" Background="Gray" Opacity="0.3" />

            <!-- ── R29 备份导出 / 导入 ── -->
            <StackPanel Spacing="8">
                <TextBlock Text="备份导出 / 导入（R29）" FontWeight="SemiBold" FontSize="14" />
                <TextBlock
                    Text="导出为明文 JSON 文件（含全部密钥明文与接口地址），导入时逐条用当前主密钥重新加密上传。"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Foreground="Gray" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button
                        Content="导出备份"
                        Click="OnExportClick"
                        IsEnabled="{x:Bind ViewModel.IdleEnabled, Mode=OneWay}" />
                    <Button
                        Content="导入备份"
                        Click="OnImportClick"
                        IsEnabled="{x:Bind ViewModel.IdleEnabled, Mode=OneWay}" />
                </StackPanel>

                <!-- 导出明文警告确认（内联，避免嵌套 ContentDialog） -->
                <Border
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    CornerRadius="6"
                    Padding="10"
                    Visibility="{x:Bind ViewModel.ExportConfirmVisibility, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="导出的是【明文】JSON 文件，包含全部密钥明文、接口地址等敏感信息。请妥善保管，导出后建议尽快删除。确认导出？"
                            FontSize="12"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="确认导出" Click="OnExportConfirmClick" />
                            <Button Content="取消" Click="OnExportCancelClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Height="1" Background="Gray" Opacity="0.3" />

            <!-- ── 应用设置（Windows 集成） ── -->
            <StackPanel Spacing="8">
                <TextBlock Text="应用设置" FontWeight="SemiBold" FontSize="14" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="开机自动启动" FontSize="12" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.StartupEnabled, Mode=TwoWay}" />
                </Grid>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="关闭窗口时最小化到托盘" FontSize="12" VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.MinimizeToTrayOnClose, Mode=TwoWay}" />
                </Grid>
                <TextBlock Text="全局快捷键 Ctrl+Shift+K 可从任意窗口唤起 KeyBox。" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
            </StackPanel>

            <Border Height="1" Background="Gray" Opacity="0.3" />

            <!-- ── R21 改主密码 ── -->
            <StackPanel Spacing="8">
                <TextBlock Text="修改主密码（R21）" FontWeight="SemiBold" FontSize="14" />
                <TextBlock
                    Text="本机会用原主密码逐条解密、用新主密码重加密后再整批提交；任何一条失败都会整体中止，不会产生「半新半旧」。"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Foreground="Gray" />
                <TextBlock
                    Text="{x:Bind ViewModel.ReloginWarning, Mode=OneWay}"
                    FontSize="12"
                    Foreground="OrangeRed"
                    TextWrapping="Wrap" />
                <PasswordBox
                    Header="原主密码"
                    Password="{x:Bind ViewModel.OldPwd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{x:Bind ViewModel.IdleEnabled, Mode=OneWay}" />
                <PasswordBox
                    Header="新主密码（至少 8 位）"
                    Password="{x:Bind ViewModel.NewPwd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{x:Bind ViewModel.IdleEnabled, Mode=OneWay}" />
                <PasswordBox
                    Header="确认新主密码"
                    Password="{x:Bind ViewModel.ConfirmPwd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{x:Bind ViewModel.IdleEnabled, Mode=OneWay}" />
                <PasswordBox
                    Header="恢复码（用于重包裹，保持其可用）"
                    Password="{x:Bind ViewModel.RecoveryCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    IsEnabled="{x:Bind ViewModel.IdleEnabled, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.RecoveryCodeInputVisibility, Mode=OneWay}" />
                <Button
                    Content="修改主密码"
                    Click="OnRotateClick"
                    IsEnabled="{x:Bind ViewModel.IdleEnabled, Mode=OneWay}"
                    HorizontalAlignment="Stretch" />

                <!-- 改主密码确认（内联，含硬约束文案） -->
                <Border
                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                    CornerRadius="6"
                    Padding="10"
                    Visibility="{x:Bind ViewModel.RotateConfirmVisibility, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="即将修改主密码：本机会用原主密码逐条解密、用新主密码重加密后整批提交。"
                            FontSize="12"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{x:Bind ViewModel.ReloginConfirmLine, Mode=OneWay}"
                            FontSize="12"
                            Foreground="OrangeRed"
                            TextWrapping="Wrap" />
                        <TextBlock Text="确认继续？" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="确认修改" Click="OnRotateConfirmClick" />
                            <Button Content="取消" Click="OnRotateCancelClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
