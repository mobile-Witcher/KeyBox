# KeyBox 环境变量示例 —— 只放"键名"，不放任何真值。
# 用法：复制本文件为 .env.local，再填入你自己的真实值；.env.local 已被 .gitignore 挡住，不会入库。

# ── 前端可见（会打进客户端包，只放"公开可见"的凭据；受表级 GRANT + 行级 RLS 约束）──
# CloudBase 环境 ID（形如 xxxx-xxxxxxxx；属受保护信息，切勿提交真值）
VITE_CLOUDBASE_ENV_ID=
# CloudBase Publishable Key（前端可用的公钥，映射到 anon 角色）
VITE_PUBLISHABLE_KEY=
# CloudBase 地域（例如 ap-shanghai）
VITE_CLOUDBASE_REGION=

# 登录前函数（初始化 / 注册 / 登录）的 HTTP 网关基址（形如 https://<envId>-<appId>.<region>.app.tcloudbase.com；
# 属公开可见信息）。留空则这三个函数回退为 SDK 调用——在函数安全规则未放行匿名的环境里会 403。

# ── 仅云函数侧使用（service_role，绕过 RLS；绝不能用 VITE_ 前缀，绝不进前端）──
# CloudBase API Key（云函数持服务端凭据读敏感列用）
CLOUDBASE_API_KEY=
# 自定义登录私钥文件路径（该文件本身被 .gitignore 挡住，不进仓库）
TCB_CUSTOM_LOGIN_KEY_FILE=
