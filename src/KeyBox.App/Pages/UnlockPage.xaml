<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KeyBox.App.Pages.UnlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource KbBgBrush}">
        <StackPanel
            Width="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="14">
            <TextBlock
                Text="解锁 KeyBox"
                FontSize="28"
                FontWeight="Bold"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="{x:Bind ViewModel.UidText, Mode=OneWay}"
                FontSize="12"
                Foreground="{ThemeResource KbMutedBrush}"
                HorizontalAlignment="Center"
                Margin="0,0,0,8" />

            <!-- Windows Hello 解锁（有包裹物且可用时显示，加载时自动弹验证） -->
            <Button
                Content="使用 Windows Hello 解锁"
                Command="{x:Bind ViewModel.HelloUnlockCommand}"
                Visibility="{x:Bind ViewModel.HelloButtonVisibility, Mode=OneWay}" />

            <PasswordBox
                Header="主密码"
                PlaceholderText="请输入主密码"
                Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.UnlockCommand}"
                Content="解锁" />

            <!-- 首次主密码解锁成功后的引导：启用 Windows Hello -->
            <StackPanel
                Spacing="8"
                Visibility="{x:Bind ViewModel.EnableHelloPanelVisibility, Mode=OneWay}">
                <TextBlock
                    Text="启用 Windows Hello 解锁？下次打开免输主密码"
                    FontSize="13"
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.EnableHelloCommand}"
                    Content="启用 Windows Hello 解锁" />
                <Button
                    HorizontalAlignment="Stretch"
                    Command="{x:Bind ViewModel.SkipHelloCommand}"
                    Content="暂不" />
            </StackPanel>

            <ProgressRing
                Width="28"
                Height="28"
                HorizontalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" />

            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="{ThemeResource KbMutedBrush}"
                TextWrapping="Wrap"
                HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
