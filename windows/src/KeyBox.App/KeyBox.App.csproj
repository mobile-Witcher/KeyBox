<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>KeyBox.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;x86;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <!-- NETSDK1206：WindowsAppSDK 自带 win10-* RID 资产，WinUI 自包含场景属良性告警 -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- exe / 任务栏 / 资源管理器 图标：多尺寸 ICO（16~256 帧，全 32bpp DIB，兼容性最稳）
         图标源：本项目的安卓（Web 打包）版 mipmap-xxxhdpi/ic_launcher_foreground.png(432px) -->
    <ApplicationIcon>Assets\keybox.ico</ApplicationIcon>
    <Company>mobile-Witcher</Company>
    <Copyright>© 2026 mobile-Witcher</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.0.131" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240802000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.756" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeyBox.Core\KeyBox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\**" />
    <!-- 托盘图标与 MSIX 徽标：随输出目录提供，供 ms-appx:///Assets/... 与打包使用 -->
    <Content Include="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
