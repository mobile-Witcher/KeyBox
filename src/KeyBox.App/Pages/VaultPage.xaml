<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KeyBox.App.Pages.VaultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:KeyBox.App.ViewModels">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 + uid + 刷新 + 退出 -->
        <Grid
            Grid.Row="0"
            Padding="16,12"
            ColumnSpacing="8"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="密钥库" FontSize="20" FontWeight="Bold" />
                <TextBlock
                    Text="{x:Bind ViewModel.UidText, Mode=OneWay}"
                    FontSize="11"
                    Foreground="Gray" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Content="刷新"
                Command="{x:Bind ViewModel.RefreshCommand}"
                VerticalAlignment="Center" />
            <Button
                Grid.Column="2"
                Content="退出登录"
                Command="{x:Bind ViewModel.LogoutCommand}"
                VerticalAlignment="Center" />
        </Grid>

        <!-- 列表区 -->
        <Grid Grid.Row="1">
            <ListView
                ItemsSource="{x:Bind ViewModel.Items}"
                SelectionMode="None"
                Padding="12,8">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:VaultItemViewModel">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock
                                        Text="{x:Bind Site}"
                                        FontSize="16"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="{x:Bind Subtitle}"
                                        FontSize="12"
                                        Foreground="Gray" />
                                    <TextBlock
                                        Text="{x:Bind ErrorText}"
                                        FontSize="12"
                                        Foreground="OrangeRed"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind ErrorVisibility}" />
                                    <TextBlock
                                        Text="{x:Bind KeyDisplay}"
                                        FontSize="13"
                                        FontFamily="Consolas"
                                        Foreground="DodgerBlue"
                                        Visibility="{x:Bind KeyVisibility}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Content="复制"
                                    VerticalAlignment="Center"
                                    Click="OnCopyClick"
                                    Visibility="{x:Bind CopyButtonVisibility}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ProgressRing
                Width="36"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading}"
                Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}" />

            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Foreground="Gray"
                TextWrapping="Wrap"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="16,0,16,14" />
        </Grid>
    </Grid>
</Page>
